# ==========================================
# Command Centre - Environment Configuration
# ==========================================

# Garmin Connect Credentials (optional, simulated fallback active if blank)
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
# Directory where Garmin session tokens and cookies are cached
GARMIN_TOKENS_DIR=.garmin_tokens

# LLM Structured Output Configuration
# Add either Gemini or OpenAI API key (or leave empty for built-in NLP fallback)
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
# Provider preference: 'auto', 'gemini', or 'openai'
LLM_PROVIDER=auto

# Database Configuration (SQLite relational storage)
DATABASE_URL=sqlite:///./command_centre.db

# Scheduled Sync Settings
SYNC_ENABLED=true
SYNC_HOUR=23
SYNC_MINUTE=30

# Security / Access Passcode
# Set this to any strong passcode to lock down the dashboard and backend API for personal use
APP_ACCESS_TOKEN=your_secure_passcode_here

# University Feeds & Historical Deliverables Database (Optional)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=dashboard
MYTIMETABLE_ICAL_URL=https://mytimetable.durham.ac.uk/calendar/export/<your_token>.ics
BLACKBOARD_ICAL_URL=https://blackboard.durham.ac.uk/webapps/calendar/calendarFeed/<your_token>/learn.ics
